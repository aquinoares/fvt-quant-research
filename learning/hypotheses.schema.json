{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trilha A hypothesis record",
  "type": "object",
  "required": [
    "id",
    "created_at_utc",
    "instrument",
    "interval",
    "hypothesis",
    "entry_rule",
    "exit_rule",
    "cost_model",
    "validation_plan",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "interval": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "entry_rule": {
      "type": "string",
      "minLength": 1
    },
    "exit_rule": {
      "type": "string",
      "minLength": 1
    },
    "cost_model": {
      "type": "string",
      "minLength": 1
    },
    "validation_plan": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "testing",
        "rejected",
        "inconclusive",
        "validated"
      ]
    },
    "result_source": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
